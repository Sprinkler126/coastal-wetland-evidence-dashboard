  "evidence_types": {
    "FACT": {
      "label": "事实",
      "definition": "由权威面板确定性计算的结果",
      "allowed": "报告时期、尺度、数值和计算规则",
      "not_allowed": "未经数据支持的机制或因果解释"
    },
    "ASSOCIATION": {
      "label": "统计关联",
      "definition": "控制城市和年份固定效应后的统计关联方向及不确定性",
      "allowed": "关联方向、p 值、置信区间和稳健性",
      "not_allowed": "确定因果或政策效果"
    },
    "MODEL_ATTRIBUTION": {
      "label": "模型归因",
      "definition": "变量在拟合模型中的预测贡献或归因",
      "allowed": "模型贡献、SHAP、预测贡献",
      "not_allowed": "因果影响或生态机制已被证明"
    },
    "EXPLORATORY": {
      "label": "探索性解释",
      "definition": "基于现有证据提出、仍需核查的解释或假设",
      "allowed": "复核假设和补充数据建议",
      "not_allowed": "把假设写成事实"
    },
    "INSUFFICIENT": {
      "label": "Insufficient data",
      "definition": "模型失败、不稳定诊断或资料限制导致只能提示复核的内部证据状态",
      "allowed": "明确限制、复核需求和补充资料建议",
      "not_allowed": "未来风险概率、低风险、无风险或自动审批"
    }
  },
